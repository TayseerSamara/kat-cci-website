rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these accounts may edit the public class schedule.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'nora@katcci.com',
          'tony@midwayspeedpark.com',
          'tony@katcci.com'
        ];
    }

    // Public class schedule: anyone can read, only editors can write.
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Student roster: private — editors only (contains personal info).
    match /students/{studentId} {
      allow read, write: if isEditor();
    }

    // Contact/lead form: anyone may submit (validated), only editors can read.
    match /leads/{leadId} {
      allow read, update, delete: if isEditor();
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'phone', 'classType', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 40
        && request.resource.data.classType is string
        && request.resource.data.classType.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    // Review request history: private — editors only (contains personal info).
    match /reviewRequests/{requestId} {
      allow read, write: if isEditor();
    }

    // Class pricing (staff Class Pricing): editors only. Four positive website prices, plus for each
    // fixed-price regular class the amount an editor confirmed its fixed Stripe Payment Link charges
    // (*Stripe). Stamped with the saving editor. Stripe links are NOT stored here (they live in code).
    match /settings/pricing {
      allow read: if isEditor();
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['ccl16', 'renewal3', 'womens', 'privateFrom',
             'ccl16Stripe', 'renewal3Stripe', 'womensStripe', 'updatedAt', 'updatedBy'])
        && validPrice(request.resource.data.ccl16)
        && validPrice(request.resource.data.renewal3)
        && validPrice(request.resource.data.womens)
        && validPrice(request.resource.data.privateFrom)
        && validPrice(request.resource.data.ccl16Stripe)
        && validPrice(request.resource.data.renewal3Stripe)
        && validPrice(request.resource.data.womensStripe)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Public pricing for the website: the Private "From $___" price and, per regular class, the
    // price it can be booked online at. Anyone may read it; only editors may write it, and only
    // together with settings/pricing (same batch) so it always mirrors the saved pricing: a regular
    // value equals the website price when that matches the confirmed Stripe amount, otherwise null.
    match /settings/publicPricing {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['privateFrom', 'ccl16', 'renewal3', 'womens'])
        && request.resource.data.keys().hasAll(['privateFrom', 'ccl16', 'renewal3', 'womens'])
        && existsAfter(/databases/$(database)/documents/settings/pricing)
        && mirrorsPricing(request.resource.data,
             getAfter(/databases/$(database)/documents/settings/pricing).data);
    }

    function mirrorsPricing(pub, pr) {
      return pub.privateFrom == pr.privateFrom
        && pub.ccl16 == bookable(pr.ccl16, pr.ccl16Stripe)
        && pub.renewal3 == bookable(pr.renewal3, pr.renewal3Stripe)
        && pub.womens == bookable(pr.womens, pr.womensStripe);
    }

    // Online price for a regular class: website price when it equals the confirmed Stripe amount.
    function bookable(website, stripe) {
      return website == stripe ? website : null;
    }

    function validPrice(p) {
      return (p is int || p is float) && p > 0 && p < 100000;
    }

    // Review settings (Google review link, default message): editors only.
    match /settings/reviews {
      allow read, write: if isEditor();
    }

    // Everything else is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
